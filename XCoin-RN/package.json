{
  "name": "xcoin-rn",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:release": "OBFUSCATE=true expo run:android --variant release",
    "ios:release": "OBFUSCATE=true expo run:ios --configuration Release",
    "bundle:analyze": "OBFUSCATE=true npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output ./bundle-output.js",
    "firebase-debug:android": "adb shell setprop debug.firebase.analytics.app com.definex.xcoin",
    "firebase-debug:android:off": "adb shell setprop debug.firebase.analytics.app .none."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/analytics": "^23.8.4",
    "@react-native-firebase/app": "^23.8.4",
    "@react-native-firebase/crashlytics": "^23.8.4",
    "@react-native-firebase/remote-config": "^23.8.4",
    "axios": "^1.13.2",
    "base64-js": "^1.5.1",
    "expo": "~54.0.31",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.10",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.21",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "i18next": "^25.7.4",
    "memoize-one": "^6.0.0",
    "nativewind": "~4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.5.3",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "use-latest-callback": "0.1.9"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "^54.0.9",
    "obfuscator-io-metro-plugin": "^2.1.3",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react-native-svg-transformer": "^1.5.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "private": true,
  "overrides": {
    "use-latest-callback": "0.1.9"
  }
}